<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mde.Project.Mobile.Resources.Styles.Purple">

    <!-- Primary kleuren -->
    <Color x:Key="Primary">#7B1FA2</Color>
    <Color x:Key="PrimaryDark">#4A148C</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>

    <!-- Secundaire accenten -->
    <Color x:Key="Secondary">#E1BEE7</Color>
    <Color x:Key="SecondaryDarkText">#000000</Color>

    <!-- Extra accent -->
    <Color x:Key="Tertiary">#BA68C8</Color>
    <!-- Tekst -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#121212</Color>
</ResourceDictionary>