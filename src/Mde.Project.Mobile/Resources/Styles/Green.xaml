<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mde.Project.Mobile.Resources.Styles.Green">

    <!-- Primary kleuren -->
    <Color x:Key="Primary">#2E7D32</Color>
    <Color x:Key="PrimaryDark">#1B5E20</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>

    <!-- Secundaire accenten -->
    <Color x:Key="Secondary">#C8E6C9</Color>
    <Color x:Key="SecondaryDarkText">#000000</Color>

    <!-- Extra accent -->
    <Color x:Key="Tertiary">#66BB6A</Color>
    <!-- Tekst -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
</ResourceDictionary>