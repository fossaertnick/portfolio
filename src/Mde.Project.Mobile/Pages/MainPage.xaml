<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="https://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Mde.Project.Mobile.Pages.MainPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarIsVisible="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
            
        <Button 
            x:Name="AddButton"
            Clicked="AddButton_Clicked"
            Text="ADD"
            FontSize="90"
            WidthRequest="250"
            HeightRequest="250"
            CornerRadius="125"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>

        <Button 
            x:Name="ListButton"
            Clicked="ListButton_Clicked"
            Text="List"
            WidthRequest="200"
            HeightRequest="20"
            Grid.Row="1"
            Grid.Column="0"
            HorizontalOptions="Center"
            Margin="5,0,0,0"/>
            
        <Button 
            x:Name="AvatarButton"
            ImageSource="dotnet_bot.png"
            Clicked="AvatarButton_Clicked"
            HorizontalOptions="Center"
            WidthRequest="200"
            HeightRequest="20"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,5,0"/>
    </Grid>
</ContentPage>