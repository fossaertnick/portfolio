<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="https://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Mde.Project.Mobile.ViewModels"
             x:DataType="viewModels:MainViewModel"
             x:Class="Mde.Project.Mobile.Pages.MainPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarIsVisible="False">
    
    <Grid HorizontalOptions="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
            
        <Button 
            Command="{Binding NavigationCommand}"
            Style="{x:StaticResource RoundButton}"
            CommandParameter="add"
            Text="ADD"
            Grid.ColumnSpan="2"/>

        <HorizontalStackLayout Grid.Row="1" Spacing="10">
            <Button 
                Command="{Binding NavigationCommand}"
                Style="{x:StaticResource FullButtons}"
                CommandParameter="list"
                Text="List"/>

            <Button 
                Command="{Binding NavigationCommand}"
                Style="{x:StaticResource FullButtons}"
                CommandParameter="//settingsPage"
                ImageSource="dotnet_bot.png"/>
        </HorizontalStackLayout>
        
    </Grid>
</ContentPage>