<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Mde.Project.Mobile.ViewModels"
             x:DataType="viewModels:SettingsViewModel"  
             x:Class="Mde.Project.Mobile.Pages.SettingsPage">
    <VerticalStackLayout Spacing="15" Padding="20">

        <Label Text="Settings" FontSize="35" HorizontalOptions="End" Margin="0,0,30,0"/>

        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="25,25,25,0"
                                   RadioButtonGroup.GroupName="Occation" 
                                   RadioButtonGroup.SelectedValue="{Binding ColorPalet}">
            <RadioButton Content="App green"/>
            <RadioButton Content="Light/Dark"/>
            <RadioButton Content="BloodRed"/>
            <RadioButton Content="DeepBlue"/>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>