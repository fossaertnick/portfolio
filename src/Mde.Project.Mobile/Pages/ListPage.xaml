<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:locations="clr-namespace:Mde.Project.Mobile.Core.Entities;assembly=Mde.Project.Mobile.Core"
             xmlns:viewModels="clr-namespace:Mde.Project.Mobile.ViewModels"
             x:DataType="viewModels:ListViewModel"
             x:Class="Mde.Project.Mobile.Pages.ListPage"
             x:Name="page"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="10">
            <Border Style="{x:StaticResource SearchBorders}">
                <SearchBar Placeholder="Filter..." Text="{Binding SearchTerm}" Keyboard="Text"/>
            </Border>

            <Button Command="{Binding NavigationCommand}" Style="{x:StaticResource FullButtons}" CommandParameter="map" Text="Map"/>
        </HorizontalStackLayout>

            <CollectionView x:Name="MemoriaList" ItemsSource="{Binding Locations}"
                            Grid.Row="1" Margin="{x:StaticResource DefaultMargin}">
            <CollectionView.EmptyView>
                <Label Text="Er zijn geen memorias om weer te geven"/>
            </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="locations:Memoria">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems >
                                <SwipeItem x:Name="DeleteButton" Clicked="DeleteButton_Clicked" BindingContext="{Binding Id}"
                                           Text="Delete" BackgroundColor="Red"/>
                                <SwipeItem Command="{Binding BindingContext.UpdateMemoriaCommand, Source={x:Reference page}}" 
                                           CommandParameter="{Binding Id}" Text="Update" BackgroundColor="Orange"/>
                                <SwipeItem Command="{Binding BindingContext.DetailsMemoriaCommand, Source={x:Reference page}}" 
                                           CommandParameter="{Binding Id}" Text="Details" BackgroundColor="Gray"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border StrokeThickness="1"
                                    Stroke="LightGray"
                                    StrokeShape="RoundRectangle 10"
                                    Margin="5"
                                    Padding="10">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.DetailsMemoriaCommand, Source={x:Reference page}}" 
                                                      NumberOfTapsRequired="1" CommandParameter="{Binding Id}"/>
                            </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="10">

                                    <!-- Titel -->
                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold" />

                                    <!-- Subtekst -->
                                <Label Grid.Column="1"
                                           Grid.Row="1"
                                           FontSize="12"
                                           TextColor="Gray" 
                                           Text="{Binding CreatedOn}"/>

                            </Grid>

                            </Border>
                        </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2" Spacing="10">
            <Button 
                Command="{Binding NavigationCommand}"
                Style="{x:StaticResource FullButtons}"
                CommandParameter="add"
                Text="Add"/>

            <Button 
                ImageSource="dotnet_bot.png"
                Command="{Binding NavigationCommand}"
                Style="{x:StaticResource FullButtons}"
                CommandParameter="//settingsPage"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>