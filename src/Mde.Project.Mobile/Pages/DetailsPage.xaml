<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Mde.Project.Mobile.ViewModels"
             xmlns:images="clr-namespace:Mde.Project.Mobile.Core.Entities;assembly=Mde.Project.Mobile.Core"
             x:DataType="viewModels:DetailsViewModel"
             x:Class="Mde.Project.Mobile.Pages.DetailsPage"
             x:Name="Page"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <Label Text="{Binding SelectedLocation.Name}" FontSize="24" FontAttributes="Bold"/>

            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding SelectedLocation.MemoriaAddress.City}"/>
                <Label Text="{Binding SelectedLocation.MemoriaAddress.Country}"/>
                <Label Text="{Binding SelectedLocation.MemoriaAddress.Street}"/>
                <Label Text="{Binding SelectedLocation.MemoriaAddress.HouseNumber}"/>
            </VerticalStackLayout>

            <Label Text="{Binding SelectedLocation.Description}" LineBreakMode="WordWrap"/>
            <Label Text="Photos" FontAttributes="Bold"/>


            <CollectionView ItemsSource="{Binding TemporaryItems}" ItemsLayout="HorizontalList" HeightRequest="300">
                <CollectionView.EmptyView>
                    <Label Text="This Memoria contains no images" HorizontalOptions="Center" VerticalOptions="Center"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="images:MediaItem">
                        <HorizontalStackLayout Padding="8" Spacing="10">
                            <!-- Foto -->
                            <Image
                                    Source="{Binding FilePath}"
                                    HeightRequest="300"
                                    WidthRequest="300"
                                    Aspect="AspectFill" 
                                Margin="5">
                            </Image>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Update" Command="{Binding UpdateMemoriaCommand}" CommandParameter="{Binding SelectedLocation.Id}"/>
            <Button x:Name="DeleteMemoriaButton" Clicked="DeleteMemoriaButton_Clicked" Text="Delete" 
                    BackgroundColor="Red" TextColor="White" BindingContext="{Binding SelectedLocation.Id}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>