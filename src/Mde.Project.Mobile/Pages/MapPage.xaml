<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="Mde.Project.Mobile.Pages.MapPage"
             Shell.TabBarIsVisible="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Margin="50,0,10,0">
            <SearchBar Placeholder="Filter" Grid.Row="0" Grid.Column="0" Keyboard="Text"/>
        </Border>
        <Button x:Name="ListButton" Text="List" Grid.Row="0" Grid.Column="1" HeightRequest="20" Margin="10,0,50,0" Clicked="ListButton_Clicked"/>

        <Label 
            Grid.Row="1" Grid.ColumnSpan="2" Margin="50"
            Text="Hier komt een map te staan waar de gebruiker zijn memorias op kan zien. Deze view moet nog geimplementeerd worden "/>

        <Button 
            x:Name="AddButton"
            Text="Add"
            Clicked="AddButton_Clicked"
            WidthRequest="200"
            HeightRequest="20"
            Grid.Row="2"
            Grid.Column="0"
            HorizontalOptions="Center"
            Margin="5,0,0,0"/>

        <Button 
            x:Name="AvatarButton"
            ImageSource="dotnet_bot.png"
            Clicked="AvatarButton_Clicked"
            HorizontalOptions="Center"
            WidthRequest="200"
            HeightRequest="20"
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,5,0"/>
    </Grid>
</ContentPage>