<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:viewModels="clr-namespace:Mde.Project.Mobile.ViewModels"
             x:DataType="viewModels:MapViewModel"             
             x:Class="Mde.Project.Mobile.Pages.MapPage"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Grid Style="{x:StaticResource TwoGrid}">
        <maps:Map x:Name="MapView" MapType="Street" MapClicked="MapView_MapClicked"
                  Margin="15" IsShowingUser="True" IsEnabled="{Binding HasInternet}"/>
        <Border Grid.Row="1" IsVisible="{Binding IsOffline}" Padding="{x:StaticResource DefaultPadding}" BackgroundColor="DarkRed">
            <Label Text="No internet connection has been detected. Some features may be unavailable." HorizontalOptions="Center"/>
        </Border>
    </Grid>
</ContentPage>